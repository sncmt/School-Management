# Settings for docker compose (copy to .env). The API's secrets are in server/.env.

# the live domain: admin.<domain> is the platform, <school>.<domain> each school
ROOT_DOMAIN=sncmt.com
# what browsers type: the domain, plus :port if it isn't 80/443
PUBLIC_HOST=sncmt.com
# links to school sites use this
SITE_PROTOCOL=https

# where the web container listens on this machine. 127.0.0.1 = only a reverse
# proxy on the same machine can reach it (the VPS setup); 0.0.0.0 = everyone
WEB_BIND=127.0.0.1
WEB_PORT=3000
