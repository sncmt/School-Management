/*
 * The school's student ID card design: the template it chose, its colour and what goes on
 * the back. Kept as JSON (like the result card design) so new options need no migration;
 * the server fills in defaults for anything not saved.
 */
model IdCardSetting {
  id String @id @default(cuid())

  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  settings Json

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
