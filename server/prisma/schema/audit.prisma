/**
 * A record of every deletion and every money reversal in a school: what it was, who did it
 * (a platform admin working inside the school too), why, and a copy of the record as it was.
 * Written in the same transaction as the change, so neither happens without the other.
 * Kept when the people or records involved go (no relations), like PasswordChangeLog.
 */
model AuditLog {
  id String @id @default(cuid())

  schoolId String

  // who did it, and their name then
  actorUserId String
  actorName   String
  // a platform admin working inside the school
  viaPlatform Boolean @default(false)

  // "payment.cancel", "fund.deposit.void", "student.delete", "exam.delete"...
  action     String
  entityType String
  entityId   String
  // one line a person can read: "Receipt R-00123 · 1500.00"
  summary    String
  reason     String?
  // the record (and what went with it) before the change
  snapshot   Json

  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([schoolId, entityType, entityId])
}
