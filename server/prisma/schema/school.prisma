model School {
  id         String  @id @default(cuid())
  schoolCode String  @unique
  nameEn     String
  nameBn     String

  subdomain      String       @unique
  // also the super admin's login; the public homepage shows it only when there is no publicEmail
  email          String       @unique
  // the address the public homepage shows (e.g. office@school.edu.bd); not a login
  publicEmail    String?
  // the school's own accent, one of the app's tested colours (BLUE, MAROON...); null = the default
  accentColor    String?
  // the school's sidebar colour, one of the app's dark colours (NAVY, MAROON...); null = navy
  sidebarColor   String?
  phone          String?      @unique
  website        String?
  address        String?
  language       Language     @default(BN)
  logo           String?
  favicon        String?
  status         SchoolStatus @default(PENDING)
  activationDate DateTime?
  monthlyFee     Decimal?     @db.Decimal(10, 2)
  // what a school on the yearly plan pays for a year
  yearlyFee      Decimal?     @db.Decimal(10, 2)
  // a percentage off either fee
  discount       Decimal      @default(0) @db.Decimal(5, 2)
  // monthly or yearly: chosen when the school is activated; null for schools activated before plans
  subscriptionPlan SubscriptionPlan?

  memberships       SchoolMembership[] 
  slides            SchoolSlide[]
  admissionInfo     AdmissionInfo?
  about             SchoolAbout?
  galleryPhotos     GalleryPhoto[]
  roles             Role[]
  modules           SchoolModule[]
  subscriptionPayments SubscriptionPayment[]
  students          Student[]
  academicYears     AcademicYear[]
  scheduleOverrides ScheduleOverride[]
  subjects          Subject[]
  classSubjects ClassSubject[]
  teacherProfiles   TeacherProfile[]
  resultCardSetting ResultCardSetting?
  financeSetting    FinanceSetting?
  notices           Notice[]
  notifications     Notification[]
  notificationSetting NotificationSetting?
  smsSetting        SmsSetting?
  smsTemplates      SmsTemplate[]
  smsMessages       SmsMessage[]
  homework          Homework[]
  rooms             Room[]
  admitCardSetting  AdmitCardSetting?
  idCardSetting     IdCardSetting?
  attendanceDevices AttendanceDevice[]
  devicePunches     DevicePunch[]
  devicePeople      DevicePerson[]
  deviceAttendanceSetting DeviceAttendanceSetting?
  onlinePaymentSetting    OnlinePaymentSetting?
  onlinePayments          OnlinePayment[]
  subjectTeachers   SubjectTeacher[]
  weeklyHolidayRules        WeeklyHolidayRule[]
  attendanceSessions        AttendanceSession[]
  gradingScales             GradingScale[]
  classResultSettings       ClassResultSetting[]
  exams                     Exam[]
  finalFormulas             FinalResultFormula[]
  periodTemplates           PeriodTemplate[]
  routineEntries            RoutineEntry[]
  routineSubstitutions      RoutineSubstitution[]
  teacherAttendance         TeacherAttendance[]
  nationalHolidayExclusions NationalHolidayExclusion[]
  calendarEntries           CalendarEntry[]
  classes           SchoolClass[]
  sections          Section[]
  groups            Group[]
  funds             Fund[]
  fundTransactions  FundTransaction[]
  sequences         SchoolSequence[]
  feeTypes          FeeType[]
  feeStructures     FeeStructure[]
  studentFees       StudentFee[]
  payments          Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subdomain])
  @@index([status])
}

/*
 * One paid period of a school's subscription to the platform, recorded by hand by the platform
 * admin (the school pays outside the app). Monthly: a year and month; yearly: a year. The
 * school's super admin sees these on their dashboard.
 */
model SubscriptionPayment {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  plan  SubscriptionPlan
  year  Int
  month Int? // 1-12 for a monthly payment; null for a yearly one
  // the period as a key, one record each: "2026-10" (monthly) or "2026" (yearly)
  period String

  amount Decimal? @db.Decimal(10, 2)
  paidOn DateTime @db.Date
  note   String?

  // the platform admin who recorded it
  recordedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([schoolId, period])
  @@index([schoolId, year])
}

model Module {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  type  ModuleType @default(FREE)
  price Decimal?   @db.Decimal(10, 2) // one-time price, null for FREE

  isActive Boolean @default(true)

  permissions   Permission[]
  schoolModules SchoolModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([type])
}

model SchoolModule {
  id        String  @id @default(cuid())
  schoolId  String
  moduleId  String
  isEnabled Boolean @default(true)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, moduleId])
  @@index([schoolId])
  @@index([moduleId])
  @@index([isEnabled])
}

model AcademicYear {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name      String
  startDate DateTime
  endDate   DateTime

  isCurrent Boolean @default(false)

  sectionYearConfigs SectionYearConfig[]
  scheduleOverrides  ScheduleOverride[]
  classSubjects      ClassSubject[]
  subjectTeachers    SubjectTeacher[]
  calendarEntries    CalendarEntry[]
  attendanceSessions AttendanceSession[]
  resultSettings     ClassResultSetting[]
  exams              Exam[]
  finalFormulas      FinalResultFormula[]
  routineEntries     RoutineEntry[]
  enrollments        Enrollment[]
  feeStructures      FeeStructure[]
  studentFees        StudentFee[]
  homework           Homework[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, isCurrent])
}

model SchoolClass {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  name         String // "Class 1", "Six", "Nursery"
  numericLevel Int // for sorting + promotion logic (Nursery=0, Class 1=1, ...)

  sections              Section[]
  enrollments           Enrollment[]
  scheduleOverrideRules ScheduleOverrideRule[]
  classSubjects ClassSubject[]
  calendarEntryClasses CalendarEntryClass[]
  resultSettings       ClassResultSetting[]
  examClasses          ExamClass[]
  finalFormulas        FinalResultFormula[]
  routineEntries       RoutineEntry[]
  feeStructures         FeeStructure[]
  noticeTargets         NoticeTarget[]
  homework              Homework[]
  studentFees           StudentFee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([schoolId, numericLevel])
}

model Section {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classId String
  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  name String // "A", "B"

  // the section created automatically for a class that has none (a school that does not
  // use sections); the UI hides its label. Renaming it makes it an ordinary section.
  isDefault Boolean @default(false)

  enrollments           Enrollment[]
  scheduleOverrideRules ScheduleOverrideRule[]
  yearConfigs           SectionYearConfig[]
  subjectTeachers       SubjectTeacher[]
  routineEntries        RoutineEntrySection[]
  attendanceSessions    AttendanceSession[]
  noticeTargets         NoticeTarget[]
  homeworkSections      HomeworkSection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, classId, name])
  @@index([schoolId])
  @@index([classId])
}

model SectionYearConfig {
  id String @id @default(cuid())

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  classTeacherMembershipId String?
  classTeacherMembership   SchoolMembership? @relation(fields: [classTeacherMembershipId], references: [id], onDelete: SetNull)

  capacity Int?

  // the section's normal class hours this year, 24-hour "HH:mm". Changing them never
  // rewrites history: attendance keeps a copy of the times in force on its own day.
  startTime String?
  endTime   String?

  // the section's periods this year (bell schedule); a schedule change can swap it for some days
  periodTemplateId String?
  periodTemplate   PeriodTemplate? @relation(fields: [periodTemplateId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, academicYearId]) // one config row per section per year
  @@index([sectionId])
  @@index([academicYearId])
  @@index([classTeacherMembershipId])
}

/*
 * A study group such as Science, Business Studies or Humanities (classes 9-10). A student
 * joins one through their enrollment, and subjects can be assigned to one group only.
 * Names are unique per school ignoring case (partial indexes in the groups migration).
 */
model Group {
  id       String @id @default(cuid())
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // the name in the school's language is required; the other is optional (apps fall back to it)
  nameEn String?
  nameBn String?

  enrollments   Enrollment[]
  classSubjects ClassSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, nameEn])
  @@index([schoolId])
}

// One picture of the image slider at the top of the school's public homepage.
model SchoolSlide {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // storage key of the picture (cropped 4 : 3, 1600 x 1200)
  image     String
  // a line shown over the picture; none = just the picture
  caption   String?
  // the slider's order, lowest first
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@index([schoolId, sortOrder])
}

// The admission section of the school's public homepage, written in its settings.
model AdmissionInfo {
  id String @id @default(cuid())

  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // what to bring or meet, one line each
  requirements String[] @default([])
  // [{ label, value }]: "Forms given out" / "1 to 15 January"; free text, so ranges read naturally
  dates        Json     @default("[]")
  // [{ label, amount }]: "Admission fee" / 2000 (whole taka)
  fees         Json     @default("[]")

  updatedAt DateTime @updatedAt
}

// The about section of the school's public homepage: its own words, a picture and a few facts.
model SchoolAbout {
  id String @id @default(cuid())

  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // what the school says about itself; a blank line starts a new paragraph
  body  String  @default("")
  // storage key of its picture (cropped 4 : 3, 1200 x 900); none = the words only
  image String?
  // [{ label, value }]: "Established" / "1998", "Students" / "1,200"; up to four
  facts Json    @default("[]")

  updatedAt DateTime @updatedAt
}

// One picture of the gallery section of the school's public homepage.
model GalleryPhoto {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // storage key of the picture (its own shape, at most 1600 px on the longer side)
  image     String
  // a line under it; none = just the picture
  caption   String?
  // the gallery's order, lowest first
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  @@index([schoolId, sortOrder])
}
