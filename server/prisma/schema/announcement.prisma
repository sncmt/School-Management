// what an announcement is about: the chip the school sees next to it
enum AnnouncementKind {
  NEW_FEATURE
  CHANGE
  MAINTENANCE
}

/**
 * A note from the platform to every school's super admin: a new feature, a change in how
 * something works, planned maintenance. Written in both languages; each school reads its own.
 * It shows in the school's header bell (a school sees only those written after it joined).
 */
model PlatformAnnouncement {
  id String @id @default(cuid())

  kind AnnouncementKind

  titleEn String
  titleBn String
  bodyEn  String @db.Text
  bodyBn  String @db.Text

  reads PlatformAnnouncementRead[]

  // the platform admin who wrote it
  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

/**
 * A super admin has opened an announcement: unread ones make the bell's badge.
 */
model PlatformAnnouncementRead {
  id String @id @default(cuid())

  announcementId String
  announcement   PlatformAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}
