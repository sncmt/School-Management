/*
 * A school's SSLCommerz store, for guardians paying fees online. Each school has its own
 * merchant account, so the money settles straight into its bank; we only keep the store's
 * credentials (the password encrypted) and the school's choice of convenience charge.
 */
model OnlinePaymentSetting {
  id String @id @default(cuid())

  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // guardians see "Pay fees" only when on (and the store is set)
  enabled Boolean @default(false)
  // SSLCommerz's test system (no real money) or the live one
  sandbox Boolean @default(true)

  storeId       String?
  // AES-256-GCM sealed (shared/secretBox)
  storePassword String?

  // added to what guardians pay, in percent; 0: the school absorbs SSLCommerz's charge
  chargePercent Decimal @default(0) @db.Decimal(4, 2)

  // the last "Test connection"
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OnlinePaymentStatus {
  PENDING // sent to SSLCommerz, no answer yet
  PAID // confirmed by SSLCommerz's validation: the payment is recorded
  FAILED
  CANCELLED // the guardian left the SSLCommerz page
}

/*
 * One attempt by a guardian to pay fees online. It is recorded as a normal payment (with a
 * receipt) only once SSLCommerz's validation API confirms it, and only once, however many
 * times SSLCommerz tells us. If some of the chosen fees were paid at the office meanwhile,
 * the payment covers what is still owed and the rest is marked to be refunded.
 */
model OnlinePayment {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // Restrict: payment history must survive
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  // the family login that paid
  userId String

  // ours, sent to SSLCommerz and back
  tranId String @unique

  // the fees chosen (student fee ids), as when the payment started
  feeIds    Json
  feeAmount Decimal @db.Decimal(10, 2)
  // the convenience charge (not a school fee)
  charge    Decimal @default(0) @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  status  OnlinePaymentStatus @default(PENDING)
  sandbox Boolean

  // from SSLCommerz
  sessionKey  String?
  valId       String?
  bankTranId  String?
  cardType    String?
  // what SSLCommerz pays the school after its own charge
  storeAmount Decimal? @db.Decimal(10, 2)
  failReason  String?

  // the receipt it became
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  // paid online but no longer owed (taken at the office meanwhile): to be refunded
  refundAmount Decimal   @default(0) @db.Decimal(10, 2)
  refundedAt   DateTime?
  refundNote   String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([schoolId, status, createdAt])
  @@index([studentId])
}
