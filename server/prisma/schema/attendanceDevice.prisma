/*
 * Attendance devices (fingerprint / RFID terminals, ZKTeco-type) that report punches over
 * the internet with the ADMS "push" protocol. A device knows itself only by its serial
 * number, so a school registers that number here; punches from unregistered numbers are
 * refused. A device in use is deactivated rather than deleted (its punches stay).
 */
model AttendanceDevice {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // unique across all schools: one device belongs to one school
  serialNumber String  @unique
  name         String
  // e.g. "Main gate"
  location     String?
  isActive     Boolean @default(true)

  // what the device last told us about itself
  model      String?
  firmware   String?
  lastSeenAt DateTime?
  lastIp     String?
  // the device's own counter of the punches it has sent (sent back in the handshake)
  attlogStamp String?
  // the same for the people / fingerprints it sends us
  operlogStamp String?

  // when set, only requests from this internet address are taken (the protocol has no
  // password: a device is known by its serial number alone)
  allowedIp      String?
  // the last request refused for coming from another address (the school's address changed?)
  lastRefusedIp  String?
  lastRefusedAt  DateTime?

  punches  DevicePunch[]
  commands DeviceCommand[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

/*
 * One punch exactly as a device sent it, kept even when it cannot be turned into attendance
 * (an unknown person, a holiday). pin is the person's number on the device; punchedAt is the
 * device's local Bangladesh time as a real moment. The same punch sent twice is kept once.
 */
model DevicePunch {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  deviceId String
  // Restrict: a device with punches is deactivated, never deleted
  device   AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  pin       String
  punchedAt DateTime
  // the device's own codes: status (check-in / out…) and how the person was verified (finger, card…)
  status     Int?
  verifyType Int?
  raw        String

  // filled when the punch has been turned into attendance (or found to need none)
  processedAt DateTime?
  outcome     String?

  createdAt DateTime @default(now())

  @@unique([deviceId, pin, punchedAt])
  @@index([schoolId, punchedAt])
  @@index([processedAt])
}

/*
 * A student or a teacher as the school's devices know them: a number (PIN, unique in the
 * school) and an RFID card. Fingerprints are taken on a device and kept here so every
 * device of the school recognises the person.
 */
model DevicePerson {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // digits only (what devices accept), unique in the school
  pin String

  // one of the two
  studentId String?         @unique
  student   Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String?         @unique
  teacher   TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  cardNumber String?

  fingerprints DeviceFingerprint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, pin])
  @@unique([schoolId, cardNumber])
}

/*
 * One finger's template as a device made it (vendor data, never an image), encrypted at
 * rest. Sent only to the same school's devices.
 */
model DeviceFingerprint {
  id String @id @default(cuid())

  personId String
  person   DevicePerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  // 0-9: which finger
  fingerIndex Int
  // AES-256-GCM: iv.tag.ciphertext (base64)
  template    String
  size        Int
  valid       Int    @default(1)

  // where it was taken
  fromDeviceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personId, fingerIndex])
}

enum DeviceCommandStatus {
  PENDING
  SENT
  DONE
  FAILED
}

/*
 * A command waiting for a device (add / change / remove a person, a fingerprint). A device
 * collects them when it polls; "seq" is the number it answers with.
 */
model DeviceCommand {
  id String @id @default(cuid())

  seq Int @unique @default(autoincrement())

  deviceId String
  device   AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  body   String
  status DeviceCommandStatus @default(PENDING)
  // the device's answer: 0 done, below 0 an error
  returnCode Int?

  createdAt DateTime  @default(now())
  sentAt    DateTime?
  doneAt    DateTime?

  @@index([deviceId, status, seq])
}

/*
 * How a school's punches become attendance. Students are late after their section's start
 * time plus lateAfterMinutes; at studentAbsentAt everyone on roll who has not punched is
 * marked absent (only for sections where somebody punched that day, so a device that was
 * offline never marks a whole school absent). Teachers the same, from teacherStartTime.
 * A later punch counts as leaving once it is checkoutGapMinutes after the arrival.
 */
model DeviceAttendanceSetting {
  id String @id @default(cuid())

  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  lateAfterMinutes Int     @default(10)
  // "HH:mm"; null: students are never marked absent by the device
  studentAbsentAt  String? @default("10:00")

  teacherStartTime        String  @default("08:00")
  teacherLateAfterMinutes Int     @default(10)
  teacherAbsentAt         String? @default("10:30")

  checkoutGapMinutes Int @default(60)

  // the last day the absent marks were made (so they are made once a day)
  studentAbsentDoneOn DateTime? @db.Date
  teacherAbsentDoneOn DateTime? @db.Date

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
