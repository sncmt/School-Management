// what happened; the app writes the sentence from this and `data`, in the reader's language
enum NotificationType {
  STUDENT_ADMITTED
  PAYMENT_RECEIVED
  PAYMENT_CANCELLED
  STUDENT_PRESENT
  STUDENT_ABSENT
  STUDENT_LATE
  RESULT_PUBLISHED
  ADMIT_CARD_RELEASED
  // the monthly reminder: what is owed now
  FEE_DUE
  // end of year: moved up a class, or graduated
  STUDENT_PROMOTED
}

/* A school's choices for in-app messages: the types it doesn't send (e.g. the daily "present"). */
model NotificationSetting {
  id String @id @default(cuid())

  schoolId String @unique
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  mutedTypes NotificationType[] @default([])

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/*
 * A message in a user's in-app inbox, made by the system when something happens (a student
 * admitted, a fee paid, absent today...). For now they go to the family login; siblings share
 * that login, so each message names its student.
 */
model Notification {
  id String @id @default(cuid())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  // who reads it
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // the student it is about, if any
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  type NotificationType
  // what the sentence needs: names (both languages), amounts, dates
  data Json

  // one message per thing: re-marking attendance updates that day's message instead of
  // adding another. Null for messages that can repeat.
  dedupeKey String?

  readAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, schoolId, createdAt])
  @@index([userId, schoolId, readAt])
  @@index([schoolId, dedupeKey])
}

/*
 * A phone that gets push notifications: the mobile app's Firebase token, one row per install.
 * It follows the school the app is logged in to and the app's language, and goes when the app
 * logs out or Firebase reports the token dead. Every new in-app message is also pushed.
 */
model DeviceToken {
  id String @id @default(cuid())

  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // the school the app is logged in to: only its messages are pushed. No relation: the app
  // re-registers on every login, and a closed school's rows simply get nothing.
  schoolId String

  // the language the app shows (and so the notification's text)
  language SmsLanguage @default(BN)
  platform String      @default("android")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, schoolId])
}
