<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+: the launcher shapes it (circle, squircle...). Android 13+ themed icons use the
     monochrome layer. Android 7.0-7.1 use the PNGs in mipmap-*dpi (mobile/store/make-icons.mjs). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/brand" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
